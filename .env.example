# --- Meko: the PRODUCT datapack (never the <team>-build datapack) ---
# Leave MEKO_API_KEY empty to run with the offline fake (tests only, never for the demo).
MEKO_API_KEY=
MEKO_DATAPACK_ID=
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_ENABLED=true

# --- LLM --- (empty key = rule-based offline stand-in)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Demo timings ---
CHECK_SECONDS=8
STORM_SECONDS=20
WATCH_INTERVAL_SECONDS=3
ERROR_THRESHOLD=0.05
FAST_PATH_CONFIDENCE=0.6

# --- Alerts (optional): every incident step is POSTed here, e.g. an n8n flow that sends WhatsApp ---
FIXONCE_WEBHOOK_URL=
FIXONCE_WEBHOOK_SECRET=
FIXONCE_PUBLIC_URL=http://localhost:8000
